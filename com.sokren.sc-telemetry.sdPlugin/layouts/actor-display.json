{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "com.sokren.sc-telemetry.actor-display",
	"items": [
		{
			"key": "label",
			"type": "text",
			"rect": [12, 8, 176, 22],
			"font": { "size": 15, "weight": 500 },
			"alignment": "left",
			"color": "#9AA4B2"
		},
		{
			"key": "value",
			"type": "text",
			"rect": [16, 32, 168, 36],
			"font": { "size": 28, "weight": 700 },
			"alignment": "left",
			"color": "#FFFFFF"
		},
		{
			"key": "indicator",
			"type": "bar",
			"rect": [16, 76, 168, 12],
			"subtype": 0,
			"border_w": 0,
			"bar_bg_c": "#2A3038",
			"bar_fill_c": "#5F5E5A",
			"range": { "min": 0, "max": 100 },
			"value": 0
		}
	]
}
