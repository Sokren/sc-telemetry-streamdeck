{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "SC Telemetry Deck",
	"Version": "0.3.5.0",
	"Author": "Sokren",
	"Actions": [
		{
			"Name": "Actor Action",
			"UUID": "com.sokren.sc-telemetry.actor-action",
			"Icon": "imgs/actions/actor-action/icon",
			"Tooltip": "Triggers a character action or an emote in Star Citizen.",
			"PropertyInspectorPath": "ui/actor-action.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/actor-action/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Morse Code",
			"UUID": "com.sokren.sc-telemetry.morse-code",
			"Icon": "imgs/actions/morse-code/icon",
			"Tooltip": "Flashes the flashlight in Morse code (the flashlight must be off at start).",
			"PropertyInspectorPath": "ui/morse-code.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/morse-code/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Actor Display",
			"UUID": "com.sokren.sc-telemetry.actor-display",
			"Icon": "imgs/actions/actor-display/icon",
			"Tooltip": "Shows a character vital (oxygen, health, temperature…) with a colored gauge.",
			"PropertyInspectorPath": "ui/actor-display.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/actor-display.json",
				"TriggerDescription": {
					"Rotate": "Change value"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/actor-display/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Ship Display",
			"UUID": "com.sokren.sc-telemetry.ship-display",
			"Icon": "imgs/actions/ship-display/icon",
			"Tooltip": "Shows the ship's countermeasures, weapons ready, weapon group or gimbals, with a colored gauge.",
			"PropertyInspectorPath": "ui/ship-display.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/actor-display.json",
				"TriggerDescription": {
					"Rotate": "Change value"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/ship-display/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Ship Toggle",
			"UUID": "com.sokren.sc-telemetry.ship-toggle",
			"Icon": "imgs/actions/ship-toggle/icon",
			"Tooltip": "Ship function with live state: landing gear, lights, VTOL, decoupled, G-safe, power…",
			"PropertyInspectorPath": "ui/ship-toggle.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/ship-toggle/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Ship Action",
			"UUID": "com.sokren.sc-telemetry.ship-action",
			"Icon": "imgs/actions/ship-action/icon",
			"Tooltip": "Triggers a ship or seat command (flight ready, ATC, ping, quantum, seat modes…).",
			"PropertyInspectorPath": "ui/ship-action.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/ship-action/key",
					"TitleAlignment": "bottom"
				}
			]
		}
	],
	"Category": "Star Citizen",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Control Star Citizen through the game's local telemetry API.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.sokren.sc-telemetry"
}