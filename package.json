{
    "name": "sc-telemetry-streamdeck",
    "private": true,
    "description": "Plugin Stream Deck pour Star Citizen, via l'API de télémétrie locale du jeu",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.sokren.sc-telemetry\"",
        "test": "vitest run"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.6",
        "@grpc/grpc-js": "^1.14.7",
        "protobufjs": "^8.8.1"
    },
    "devDependencies": {
        "@elgato/cli": "^1.10.5",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^15.3.1",
        "@rollup/plugin-terser": "^1.0.2",
        "@rollup/plugin-typescript": "^12.3.1",
        "@tsconfig/node20": "^20.1.11",
        "@types/node": "~24.1.0",
        "rollup": "^4.68.7",
        "tslib": "^2.9.1",
        "typescript": "^5.9.3",
        "vitest": "^5.1.1"
    }
}
